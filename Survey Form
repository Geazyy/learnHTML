<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Survey Form</title>
</head>
<body>

  <!-- Page Title -->
  <h1 id="title">Student Feedback Survey</h1>

  <!-- Description -->
  <p id="description">
    Please take a moment to fill out this survey. Your feedback helps us improve.
  </p>

  <!-- Survey Form -->
  <form id="survey-form">

    <!-- Name -->
    <label id="name-label" for="name">Full Name</label>
    <input
      id="name"
      type="text"
      name="name"
      placeholder="Enter your full name"
      required
    />

    <br><br>

    <!-- Email -->
    <label id="email-label" for="email">Email Address</label>
    <input
      id="email"
      type="email"
      name="email"
      placeholder="Enter your email address"
      required
    />

    <br><br>

    <!-- Number -->
    <label id="number-label" for="number">Age</label>
    <input
      id="number"
      type="number"
      name="age"
      min="15"
      max="60"
      placeholder="Enter your age"
    />

    <br><br>

    <!-- Dropdown -->
    <label for="dropdown">Current Level</label>
    <select id="dropdown" name="level">
      <option value="student">Student</option>
      <option value="professional">Professional</option>
      <option value="other">Other</option>
    </select>

    <br><br>

    <!-- Radio Buttons -->
    <p>Would you recommend this course?</p>
    <input type="radio" name="recommend" value="yes" /> Yes<br>
    <input type="radio" name="recommend" value="no" /> No

    <br><br>

    <!-- Checkboxes -->
    <p>Which topics are you interested in? (Select all that apply)</p>
    <input type="checkbox" name="topics" value="html" /> HTML<br>
    <input type="checkbox" name="topics" value="css" /> CSS<br>
    <input type="checkbox" name="topics" value="javascript" /> JavaScript

    <br><br>

    <!-- Textarea -->
    <p>Additional Comments</p>
    <textarea
      name="comments"
      placeholder="Enter your comments here..."
      rows="4"
      cols="40"
    ></textarea>

    <br><br>

    <!-- Submit Button -->
    <button id="submit" type="submit">Submit Survey</button>

  </form>

</body>
</html>
